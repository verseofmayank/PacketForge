{
  "rules": {
    "POSSIBLE_TCP_PORT_SCAN": {
      "enabled": true,
      "threshold": 12,
      "window_seconds": 10,
      "cooldown_seconds": 30,
      "severity": "MEDIUM",
      "exclude_sources": [],
      "exclude_destinations": []
    },
    "HIGH_TCP_SYN_RATE": {
      "enabled": true,
      "threshold": 100,
      "window_seconds": 10,
      "cooldown_seconds": 30,
      "severity": "MEDIUM",
      "exclude_sources": [],
      "exclude_destinations": []
    },
    "HIGH_ICMP_ECHO_RATE": {
      "enabled": true,
      "threshold": 50,
      "window_seconds": 10,
      "cooldown_seconds": 30,
      "severity": "LOW",
      "exclude_sources": [],
      "exclude_destinations": []
    },
    "SENSITIVE_SERVICE_TRAFFIC": {
      "enabled": true,
      "threshold": 1,
      "window_seconds": 10,
      "cooldown_seconds": 60,
      "severity": "INFO",
      "exclude_sources": [],
      "exclude_destinations": [],
      "ports": [
        22,
        23,
        445,
        3389
      ]
    },
    "CONNECTION_CONCENTRATION": {
      "enabled": true,
      "threshold": 40,
      "window_seconds": 10,
      "cooldown_seconds": 30,
      "severity": "LOW",
      "exclude_sources": [],
      "exclude_destinations": []
    }
  },
  "limits": {
    "max_flows": 4096,
    "max_unique_flows": 65536,
    "max_talkers": 4096,
    "max_rule_keys": 1024,
    "max_rule_events": 50000,
    "max_alerts": 10000,
    "flow_timeout_seconds": 60
  },
  "policy": [
    {
      "source": "any",
      "destination": "any",
      "destination_port": 22,
      "action": "WOULD_BLOCK"
    },
    {
      "source": "any",
      "destination": "any",
      "destination_port": 445,
      "action": "WOULD_BLOCK"
    },
    {
      "source": "any",
      "destination": "any",
      "destination_port": -1,
      "action": "WOULD_ALLOW"
    }
  ]
}
